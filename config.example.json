{
  "version": 1,
  "default_printer": "workshop-mini",
  "printers": [
    {
      "id": "workshop-mini",
      "model": "a1mini",
      "host": "PRINTER_LAN_IP",
      "serial": "YOUR_PRINTER_SERIAL",
      "access_code_env": "MY_BAMBU_ACCESS_CODE",
      "nozzle_diameter": 0.4,
      "nozzle_type": "stainless_steel",
      "nozzle_confirmed": false,
      "plate_type": "textured_plate",
      "plate_confirmed": false,
      "tls_verify": false
    }
  ],
  "blender": {
    "command": "uvx",
    "args": ["mcp-for-blender"],
    "timeout_seconds": 120
  },
  "slicer": {
    "timeout_seconds": 900
  }
}
